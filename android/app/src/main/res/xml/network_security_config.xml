<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
      Cleartext is permitted ONLY for local development hosts.

      This replaces android:usesCleartextTraffic="true" on <application>, which
      allowed plain HTTP to ANY host. The live API is HTTPS
      (https://movezybackend.onrender.com) and the map tiles are HTTPS, so
      nothing in the app needs cleartext at runtime — but a blanket flag meant
      any future misconfiguration would silently send login OTPs and JWTs
      unencrypted, and Play Store review flags it.

      10.0.2.2 is the host machine as seen from the Android emulator.
    -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">10.0.2.2</domain>
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
    </domain-config>
</network-security-config>
